# Staging Environment Configuration
AWS_REGION=us-east-1
AWS_PROFILE=staging
CONFIG_BUCKET=my-bedrock-agent-configs-staging
INFRA_METHOD=cloudformation
LOG_LEVEL=info

# Game library source configuration
# If set, these values override the local public/games fallback.
# Example:
# GAME_LIBRARY_S3_BASE_URL=https://my-bucket.s3.amazonaws.com/games
# GAME_LIBRARY_S3_GAMES=["game-one.html","game-two.html"]
GAME_LIBRARY_S3_BASE_URL=
GAME_LIBRARY_S3_GAMES=
